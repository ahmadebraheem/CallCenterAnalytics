# Copy to .env and set three distinct, strong passwords (e.g. 32+ random characters).
# Single-quote values containing dollar signs so Compose does not interpolate them.
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_INGEST_PASSWORD=
CLICKHOUSE_READER_PASSWORD=

TS_HOSTNAME=callcenter-clickhouse
# Non-ephemeral Tailscale auth key for first enrollment. May be cleared once enrolled.
TS_AUTHKEY=

# dbt bootstrap creates/updates a separate SQL-managed user using this password.
CLICKHOUSE_DBT_PASSWORD=
DBT_TARGET=dev
# Generated Parquet directory on the Docker host, relative to infra/clickhouse.
DATA_DIR=../../out
